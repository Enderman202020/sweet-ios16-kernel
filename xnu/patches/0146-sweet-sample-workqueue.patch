+					    (unsigned)wq->wq_constrained_threads_scheduled, (unsigned)wq->wq_thdying_count,
+					    (uint64_t)(uintptr_t)wq->wq_creator);
+					printf("SMP %s wq2 fulfilled %u creations %u interval %u last_run %llu now %llu\n",
+					    name, (unsigned)wq->wq_fulfilled, (unsigned)wq->wq_creations,
+					    (unsigned)wq->wq_timer_interval, (uint64_t)wq->wq_thread_call_last_run,
+					    (uint64_t)mach_absolute_time());
+					{
+					    unsigned qi;
+					    const volatile uint64_t *tha = (const volatile uint64_t *)&wq->wq_thactive;
+					    printf("SMP %s wq3 thactive hi 0x%llx lo 0x%llx\n", name, (uint64_t)tha[1], (uint64_t)tha[0]);
