+					        printf("SMP %s wq3 bucket %u thsched %u lastblocked %llu\n", name, qi,
+					            (unsigned)wq->wq_thscheduled_count[qi], (uint64_t)wq->wq_lastblocked_ts[qi]);
+					    }
+					}
+				} else {
+					printf("SMP %s wq none\n", name);
+				}
+			}
 		}
 	}
